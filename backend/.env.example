APP_ENV=development

# Tesseract binary (Windows default; change if installed elsewhere)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (asyncpg)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=masklayer
POSTGRES_USER=masklayer
POSTGRES_PASSWORD=masklayer
# Or set a full URL (takes precedence over the individual vars above):
# DATABASE_URL=postgresql://masklayer:masklayer@localhost:5432/masklayer

# Set to "true" to echo all SQL statements to stdout (useful for debugging)
SQL_ECHO=false
