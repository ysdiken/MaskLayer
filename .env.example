# Copy this file to .env and fill in your values.
# Never commit .env to git — it contains real credentials.

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis
REDIS_URL=redis://:changeme_redis@localhost:6379/0

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=masklayer
POSTGRES_USER=masklayer
POSTGRES_PASSWORD=changeme_postgres
DATABASE_URL=postgresql://masklayer:changeme_postgres@localhost:5432/masklayer

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=masklayer
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_ORIGINALS=masklayer-originals
MINIO_BUCKET_MASKED=masklayer-masked

# ── OpenAI — for the document chat sidebar ────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── HuggingFace — fully offline after bake_model.py has been run ──────────────
# Run: cd backend && python scripts/bake_model.py   (once, with internet)
# Then these flags prevent any outbound HF traffic:
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
